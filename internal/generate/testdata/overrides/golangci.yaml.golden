# Code generated by project-standards from mklv.config.json. DO NOT EDIT.
#
# This is the project-standards base config with tools.golangci from
# mklv.config.json merged onto it. Edit mklv.config.json instead, then run
# `mage ci:fix`, or `project-standards fix` without Go, to regenerate it.

linters:
  default: standard
  enable:
    - bodyclose
    - dupl
    - gocognit
    - gocritic
    - revive
    - unconvert
    - gosec
  exclusions:
    rules:
      - linters:
          - gocognit
        path: _test\.go
      - linters:
          - dupl
        path: _test\.go
      - linters:
          - unused
        text: const \w+Unset is unused
  settings:
    gocognit:
      min-complexity: 40
run:
  build-tags:
    - mage
    - integration
version: "2"
